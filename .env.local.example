# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# ── Database ────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/bookoran31
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bookoran31
MONGODB_URI=

# ── Seed script (npm run seed --workspace @bookoran/db) ─────────────────
# These create the sign-in account. There are no ADMIN_EMAIL / ADMIN_PASSWORD
# variables any more — the login reads the `adminUsers` collection, so the
# account has to be CREATED by running the seed against the database the
# deployed app uses.
# Leave SEED_ADMIN_EMAIL empty and the seed creates no admin account.
# Leave SEED_ADMIN_PASSWORD empty and it generates one and prints it once —
# that is the safer option. Never ship a known seed password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# ── Auth (apps/admin) ───────────────────────────────────────────────────
# NextAuth v5 reads AUTH_SECRET, not NEXTAUTH_SECRET. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Only needed if the host does not set it for you. Vercel does.
# AUTH_URL=https://your-admin-domain

# ── Public URLs (safe to expose — they are what customers type) ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3110
NEXT_PUBLIC_STORE_URL=http://localhost:3110

# ── Yalidine — SERVER ONLY ──────────────────────────────────────────────
# Never prefix these with NEXT_PUBLIC_. Anything so prefixed is compiled
# into the browser bundle and readable by every visitor.
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
YALIDINE_FROM_WILAYA_ID=31

# ── Media ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
