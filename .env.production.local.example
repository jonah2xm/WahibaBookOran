# Production — database `bookoran31` on the same Atlas cluster.
#
# Used by:  npm run seed:prod --workspace @bookoran/db
# Ignored by git (.env*.local). Never commit it, never paste it in a chat.
#
# The SAME MONGODB_URI must be set on Vercel for both apps, or the deployed
# site reads a different database than the one this file seeds.

MONGODB_URI=mongodb+srv://<user>:<password>@wahibabooksoran.5ru9nwl.mongodb.net/bookoran31?appName=wahibaBooksOran&retryWrites=true&w=majority

# Signs the admin session cookie. Different from the dev one on purpose: a
# session minted locally must not be accepted by the live back-office.
# Set this exact value on Vercel too.
AUTH_SECRET=<run: openssl rand -base64 32>

# Node resolves mongodb+srv SRV records itself and this machine's DNS refuses
# those queries. Only needed for seeding from here — not on Vercel.
DNS_SERVERS=8.8.8.8,1.1.1.1

# The owner account the seed creates in the production database.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Owner name

# Deliberately unset: the seed then generates a strong password and prints it
# once. This account can read every customer's name, phone and address, so it
# should not share a password with anything else. Set it here only if you
# really want to choose it yourself.
# SEED_ADMIN_PASSWORD=
